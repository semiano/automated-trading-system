POSTGRES_USER=****
POSTGRES_PASSWORD=****
POSTGRES_DB=mdtas
POSTGRES_PORT=5432
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MEM_LIMIT=384m
POSTGRES_MEM_RESERVATION=256m

API_PORT=8000
WEB_PORT=5173
API_MEM_LIMIT=384m
API_MEM_RESERVATION=256m
INGESTION_MEM_LIMIT=256m
INGESTION_MEM_RESERVATION=128m
TRADER_MEM_LIMIT=256m
TRADER_MEM_RESERVATION=128m
WEB_MEM_LIMIT=256m
WEB_MEM_RESERVATION=128m
WEB_NODE_OPTIONS=--max-old-space-size=192

MDTAS_LOG_LEVEL=INFO
MDTAS_CONFIG_FILE=./config.yaml

MDTAS_CONFIG_PATH=/app/config.yaml
VITE_API_BASE_URL=http://localhost:8000/api/v1

DATABASE_URL=postgresql+psycopg://mdtas:mdtas@postgres:5432/mdtas
